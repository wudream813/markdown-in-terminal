# Maintainer: wudream813 <wudream813@users.noreply.github.com>
# Prebuilt -bin package: the release binary is statically linked, so there is
# nothing to compile and nothing to link against at run time.
pkgname=mdt-bin
pkgver=0.3.15
pkgrel=1
pkgdesc='Terminal Markdown reader: typeset maths, images, syntax highlighting'
arch=('x86_64')
url='https://github.com/wudream813/markdown-in-terminal'
license=('MIT')
depends=()
optdepends=(
    'curl: fetch images that are linked from a document'
    'xdg-utils: open links in your browser'
)
provides=('mdt')
conflicts=('mdt' 'mdt-git')
options=('!strip' '!debug')
_gh="https://github.com/wudream813/markdown-in-terminal"
_raw="https://raw.githubusercontent.com/wudream813/markdown-in-terminal"

source=("mdt-linux-amd64::$_gh/releases/download/v$pkgver/mdt-linux-amd64"
        "mdt.1::$_raw/v$pkgver/docs/mdt.1"
        "mdt.bash::$_raw/v$pkgver/completions/mdt.bash"
        "_mdt::$_raw/v$pkgver/completions/_mdt"
        "mdt.fish::$_raw/v$pkgver/completions/mdt.fish"
        "LICENSE::$_raw/v$pkgver/LICENSE")
sha256sums=('21213705f08035b15f8e39133be0586f7702095308a273899ddc80afeb1d2645'
            '84b40b08162441229c042cd9f86ee7fa6beb7c4d013de12c63c59496f36e98c0'
            '2ef8c687a3c17e67c16d8fd50104efdd363ce1c4b6a51eba74dc035b43e0439d'
            '0d46d75e85ce6b35c1c08457da8e166ad8c38595ea40619e3b98c3a332fe0f70'
            '6b5bf1b53ef2cd41afe8c0e81e97fd388a6c1fac9dd4b3558a9f295a6781a5c0'
            '76d1905ca480632ecdabe422dda091af529d8cfc3b6512665482614483a2c826')

package() {
  install -Dm755 "$srcdir/mdt-linux-amd64" "$pkgdir/usr/bin/mdt"
  install -Dm644 "$srcdir/mdt.1"   "$pkgdir/usr/share/man/man1/mdt.1"
  install -Dm644 "$srcdir/mdt.bash" "$pkgdir/usr/share/bash-completion/completions/mdt"
  install -Dm644 "$srcdir/_mdt"     "$pkgdir/usr/share/zsh/site-functions/_mdt"
  install -Dm644 "$srcdir/mdt.fish" "$pkgdir/usr/share/fish/vendor_completions.d/mdt.fish"
  install -Dm644 "$srcdir/LICENSE"  "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
